# TrendCipher web — environment template
# Copy to web/.env or set as build args. NEVER commit a real .env.

# Brand name shown in the UI (header logo, landing, document title).
# Rebrand by changing only this value — no component edits needed.
VITE_APP_NAME=TrendCipher

# Backend API base URL used by the browser.
# Production (nginx proxy): /api/v1  |  Local dev: http://localhost:8000/api/v1
VITE_API_BASE_URL=/api/v1