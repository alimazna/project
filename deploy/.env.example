# TrendCipher — Docker Compose environment template
# Copy to deploy/.env (or the repository root .env) before `docker compose up`.
# NEVER commit a real .env.

# --- app ---
APP_NAME=TrendCipher
DEBUG=false
PUBLIC_BASE_URL=http://localhost

# --- security (MUST CHANGE in production) ---
# Generate: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-string-32+bytes
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost

# --- database (SQLite on the mounted volume by default) ---
# DATABASE_URL=sqlite:////app/data/trendcipher.db   (set by compose; keep as-is)
# Postgres option (buyer): uncomment and provide credentials.
# DATABASE_URL=postgresql+psycopg://user:pass@db:5432/trendcipher

# --- providers ---
MARKET_PROVIDER=kraken
NEWS_PROVIDER=rss
# Push delivery: log (default, labeled stub) or expo (real Expo Push Service).
PUSH_PROVIDER=log
NEWS_FEEDS=https://cointelegraph.com/rss|CoinTelegraph,https://www.coindesk.com/arc/outboundfeeds/rss/|CoinDesk

# --- ingestion loops (seconds) ---
INGESTION_LOOP_SECONDS=300
NEWS_LOOP_SECONDS=600

# --- optional credentials (public data works without these) ---
EXPO_ACCESS_TOKEN=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=