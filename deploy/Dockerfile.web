# TrendCipher web — production image (build with Vite, serve with nginx)
# Usage: docker build -f deploy/Dockerfile.web -t trendcipher-web .
FROM node:24-alpine AS build
WORKDIR /build
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
# Optionally: --build-arg VITE_API_BASE_URL=/api/v1 (same-origin proxy handled by nginx)
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

FROM nginx:alpine
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]