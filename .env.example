# TrendCipher environment template
# Copy to .env and fill in real values. NEVER commit .env.

# --- app ---
APP_NAME=TrendCipher
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8000

# --- security (MUST CHANGE in production) ---
SECRET_KEY=replace-with-a-long-random-string-32+bytes
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:5173

# --- database ---
# SQLite (default, zero-config):
DATABASE_URL=sqlite:///./trendcipher.db
# PostgreSQL (buyer option):
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/trendcipher

# --- providers ---
MARKET_PROVIDER=kraken
NEWS_PROVIDER=rss
# Push delivery: log (default, labeled stub) or expo (real Expo Push Service).
PUSH_PROVIDER=log
# Comma-separated url|name pairs:
NEWS_FEEDS=https://cointelegraph.com/rss|CoinTelegraph,https://www.coindesk.com/arc/outboundfeeds/rss/|CoinDesk

# --- ingestion loops (seconds) ---
INGESTION_LOOP_SECONDS=300
NEWS_LOOP_SECONDS=600

# --- optional credentials (public data works without these) ---
EXPO_ACCESS_TOKEN=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=